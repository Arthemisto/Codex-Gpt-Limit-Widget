<Window x:Class="LimitWidget.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex Limit Widget" Width="340" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
 <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="14" TextElement.Foreground="{DynamicResource Foreground}">
  <StackPanel>
   <Grid MouseLeftButtonDown="DragHeader" Background="Transparent" Margin="0,0,0,10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="1" x:Name="ConnectionBadge" CornerRadius="6" Padding="6,4" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#DDE5EC"><TextBlock x:Name="ConnectionLabel" Text="Connecting" FontSize="11" FontWeight="Bold" Foreground="Black"/></Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="LockButton" Click="ToggleLock" Padding="6,5" FontSize="12"/><Button x:Name="TopButton" Click="ToggleTop" ToolTip="Always on top" FontSize="12" FontWeight="Bold" Foreground="Black" Padding="6,5"/><Button Content="⚙" FontWeight="Normal" Click="OpenSettings" ToolTip="Settings" Padding="6,5"/><Button Content="×" Click="CloseWidget" ToolTip="Hide to tray" Padding="6,5"/></StackPanel>
    <DockPanel Grid.Row="2" Margin="0,4,0,0"><Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="↻" FontWeight="Normal" Click="RefreshClicked" ToolTip="Refresh Codex limits" Padding="6,2" HorizontalAlignment="Right"/><TextBlock x:Name="UpdatedLabel" Text="Not updated yet" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></DockPanel>
   </Grid>
   <Border Height="1" Background="{DynamicResource Line}"/>
   <StackPanel x:Name="QuotaRows"/>
   <TextBlock x:Name="StatusLabel" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" Visibility="Collapsed"/>
   <TextBlock x:Name="EmptyHint" Text="Select a service in Settings" Margin="0,24" HorizontalAlignment="Center" Visibility="Collapsed"/>
   <Border x:Name="LaunchDivider" Height="1" Background="{DynamicResource Line}" Margin="0,10,0,10"/>
   <Button x:Name="LaunchButton" Content="▶  Launch Codex" Background="{DynamicResource Accent}" Foreground="#10231F" Click="LaunchCodex"/>
  </StackPanel>
 </Border>
</Window>
