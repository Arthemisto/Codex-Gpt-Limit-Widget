<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.3.1</Version>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Product>Codex Limit Widget</Product>
    <AssemblyTitle>Codex Limit Widget</AssemblyTitle>
    <Description>Windows desktop widget for Codex quota and usage statistics.</Description>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/app.ico" /></ItemGroup>
</Project>
